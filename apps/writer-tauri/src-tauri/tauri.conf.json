{
  "productName": "Octave",
  "version": "0.0.10",
  "identifier": "com.minkyojung.octave",
  "build": {
    "beforeDevCommand": "pnpm --filter writer-tauri setup:binaries && pnpm --filter writer-tauri pack:sidecar && pnpm --filter writer-tauri dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter writer-tauri setup:binaries:all && pnpm --filter writer-tauri build && pnpm --filter writer-tauri pack:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1440,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "active" }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://*.ytimg.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com; frame-src 'self' asset: https://asset.localhost https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bun"
    ],
    "resources": ["../sidecar-pkg/**/*"],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMTNDQThBQjY4NDgyNkIKUldScmdvUzJpc29UUWtIdVZFR0FwMW9McERsUEtlelJhWFkzV0pHNk04aitaYkxDWWdxVndQUEMK",
      "endpoints": [
        "https://github.com/minkyojung/edit/releases/latest/download/latest.json"
      ]
    }
  }
}
