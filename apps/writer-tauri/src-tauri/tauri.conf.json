{
  "productName": "Writer",
  "version": "0.1.0",
  "identifier": "com.conductor.writer",
  "build": {
    "beforeDevCommand": "pnpm --filter writer-tauri dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter writer-tauri build && bash scripts/pack-sidecar.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": [
      "binaries/bun",
      "binaries/proof-server"
    ],
    "resources": ["../sidecar-pkg/**/*"]
  }
}
