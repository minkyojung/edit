# Notarization secrets for `pnpm release` (macOS signed + notarized build).
# Only two values, both from your Apple account. Everything else (signing
# identity, team id, updater key) is set inside scripts/build-release.sh.
#
# ── Option A · plaintext (simplest) ───────────────────────────────────────────
#   cp .env.signing.example .env.signing     # .env.signing is gitignored
#   # fill the two values below, then:
#   pnpm release
#
# ── Option B · 1Password (recommended — secrets never written to disk) ─────────
#   Store the two values in a 1Password item, then make a reference file
#   `.env.signing.op` with `op://` refs instead of real values, e.g.:
#       APPLE_ID=op://Private/Octave Apple ID/username
#       APPLE_PASSWORD=op://Private/Octave notarization/password
#   and build with:
#       op run --env-file=.env.signing.op -- pnpm release
#   (op resolves the refs and injects the real values into the process env at
#    run time; the file on disk only ever holds the op:// pointers.)

# Your Apple ID email (the one that holds the Developer Program membership).
APPLE_ID="you@example.com"

# App-specific password from https://appleid.apple.com → Sign-In and Security →
# App-Specific Passwords. Format: xxxx-xxxx-xxxx-xxxx.
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
